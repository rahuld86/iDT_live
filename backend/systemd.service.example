[Unit]
Description=Decision Tree API
Wants=network-online.target
After=network-online.target redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/project_iDT_2/backend
# start.sh loads .env, including quoted hashes and inline comments.
# No EnvironmentFile, shell expressions, stop.sh hooks, or port-killing commands.
ExecStart=/bin/bash /home/ubuntu/project_iDT_2/backend/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
