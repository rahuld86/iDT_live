# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# CORS Configuration
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=*

# AWS S3 Configuration (optional, for S3 import/export)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Gunicorn Configuration (for production)
# Multiple workers are now safe: session state is externalized to Redis + the
# DataFrame store, so no request-spanning state lives in worker memory.
PORT=5000
WEB_CONCURRENCY=4
LOG_LEVEL=info
ACCESS_LOG=-
ERROR_LOG=-

# --- Redis (session metadata store) ---
# Phase 1: same-instance Redis. Phase 2: point to the ElastiCache endpoint
# (no code change required).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=                  # optional; set when Redis requires auth

# --- Session lifecycle ---
SESSION_TTL_SECONDS=86400          # abandoned sessions expire after 24h
SESSION_CLEANUP_INTERVAL=3600      # background cleanup sweep cadence (seconds)

# --- DataFrame store (heavy pandas frames persisted outside the process) ---
DF_STORE_BACKEND=disk              # 'disk' (Phase 1) or 's3' (Phase 2)
DF_STORE_DIR=/home/ubuntu/project_iDT_2/backend/df_store   # for the disk backend
# DF_S3_BUCKET=                    # for the s3 backend (Phase 2)
# DF_S3_PREFIX=dataframes

# --- Per-worker DataFrame cache ---
DF_CACHE_MAX_BYTES=2147483648      # 2GB per-worker cache budget (tune to RAM)

# Application Settings
# Maximum upload size (in bytes), ~600MB (raised from 100MB)
MAX_UPLOAD_SIZE=629145600

# Authentication Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400
# Users format: username:hashed_password (one per line or space-separated)
# Generate hash: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
# Example: AUTH_USERS=idfcuser:$2b$12$placeholder_hash_here
AUTH_USERS=idfcuser:$2b$12$placeholder_hash_here

