# Copy to .env; deploy.sh does this only when .env is absent.
# Loaded by Bash in start.sh and python-dotenv in the app.
# Use single quotes for values containing $, spaces, or shell metacharacters.
# Never commit a populated .env.

FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# Frontend browser origin: scheme + hostname/IP + optional port; no /api or slash.
# Replace with http://YOUR_PUBLIC_IP or https://yourdomain.com for deployment.
# Multiple origins: CORS_ORIGINS='http://YOUR_PUBLIC_IP,https://yourdomain.com'
# No spaces after commas. '*' permits all origins; use only for initial testing.
# Nginx serves the frontend and /api at the same origin in the standard setup.
CORS_ORIGINS='http://localhost'

# Configure both with: ./setup_user_password.sh idfcuser
# The helper generates a JWT secret if absent and a correctly quoted scrypt hash.
JWT_SECRET_KEY=''
JWT_ACCESS_TOKEN_EXPIRES=86400  # 24 hours
# Space-separated username:hash entries on ONE line, inside single quotes.
# Add: ./setup_user_password.sh anotheruser
# Reset: ./setup_user_password.sh idfcuser --reset
AUTH_USERS=''

# Used by start.sh; bind is localhost because nginx proxies the API.
PORT=5000
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=300  # training/upload requests may exceed Gunicorn's 30s default
LOG_LEVEL=info
ACCESS_LOG=-
ERROR_LOG=-

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD='set-only-if-Redis-requires-it'
SESSION_TTL_SECONDS=86400  # inactive workspaces expire after 24h
SESSION_CLEANUP_INTERVAL=3600

# Only disk is implemented. S3 import/export is separate from DataFrame storage.
DF_STORE_BACKEND=disk
DF_STORE_DIR='./df_store'
# Per worker, NOT total memory: 4 workers x 2 GiB cache = up to 8 GiB plus overhead.
DF_CACHE_MAX_BYTES=2147483648

# S3 is optional. On EC2 attach an IAM role granting access to your bucket/prefix.
# Same-account EC2 and S3 still require permissions. No permanent keys are needed.
# Set this to your bucket's region. Remove credential placeholders for role usage.
AWS_REGION=ap-south-1
# Outside EC2, use an appropriate SDK credential provider. If static credentials
# are explicitly required, uncomment and populate BOTH values; never use root keys.
# AWS_ACCESS_KEY_ID=''
# AWS_SECRET_ACCESS_KEY=''
