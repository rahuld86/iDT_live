# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# CORS Configuration
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=*

# AWS S3 Configuration (optional, for S3 import/export)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Gunicorn Configuration (for production)
PORT=5000
WEB_CONCURRENCY=4
LOG_LEVEL=info
ACCESS_LOG=-
ERROR_LOG=-

# Application Settings
# Maximum upload size (in bytes), default: 100MB
MAX_UPLOAD_SIZE=104857600

# Authentication Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400
# Users format: username:hashed_password (one per line or space-separated)
# Generate hash: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
# Example: AUTH_USERS=idfcuser:$2b$12$placeholder_hash_here
AUTH_USERS=idfcuser:$2b$12$placeholder_hash_here

